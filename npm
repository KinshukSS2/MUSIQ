#!/bin/bash
# Simple npm wrapper for MusIQ project

if [ "$1" = "run" ] && [ "$2" = "dev" ]; then
    echo "🚀 Starting MusIQ Frontend..."
    cd /home/deadpool/MusIQ/client && /home/deadpool/MusIQ/client/node_modules/.bin/vite
elif [ "$1" = "run" ] && [ "$2" = "build" ]; then
    echo "🏗️ Building MusIQ Frontend..."
    cd /home/deadpool/MusIQ/client && /home/deadpool/MusIQ/client/node_modules/.bin/vite build
else
    echo "MusIQ npm wrapper - Available commands:"
    echo "  npm run dev    - Start development server"
    echo "  npm run build  - Build for production"
    echo ""
    echo "Or use the direct scripts:"
    echo "  ./start-frontend.sh  - Start frontend"
    echo "  ./start-backend.sh   - Start backend"
fi